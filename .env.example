# MySQL-compatible database (MySQL, TiDB, PlanetScale...)
DATABASE_URL=mysql://user:password@localhost:3306/tender_atlas

# Resend API key, used to send alert confirmation and weekly digest emails
RESEND_API_KEY=

# Email sender
FROM_EMAIL=alerts@example.com
ALERT_FROM_NAME=TenderAtlas

# Public URL of the site (used in emails, sitemap and canonical links)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Secret for the subscriber admin page (/admin/alerts?key=...) and API
ADMIN_SECRET=change-me
